# Etsy Shop Analyzer
#
# Copy to .env.local and restart the dev server. With no key present the
# analyzer runs against local fixtures, so the whole page works before your
# Etsy app is approved.

# Your Etsy Open API v3 keystring. Server-side only — never prefix with
# NEXT_PUBLIC_, which would inline it into the browser bundle.
# ETSY_API_KEY=

# auto (default) — live when ETSY_API_KEY is set, otherwise fixtures
# mock          — force fixtures even with a key present, to iterate on UI
#                 without spending the 10,000 requests/day quota
# live          — force live; fails loudly if no key is set
# ETSY_PROVIDER=auto

# Fixture behaviour, for exercising states that are hard to reproduce on demand.
# One of: ok (default) | partial | slow | not-found
# ETSY_MOCK_SCENARIO=ok

# Where analyses are stored. Defaults to ./.data
# Point this somewhere disposable for your first live run, so a bad normalizer
# cannot corrupt real history.
# SHOP_DATA_DIR=./.data-live-test

# Dump raw Etsy payloads to <SHOP_DATA_DIR>/shops/<id>/raw/ so the fixtures can
# be diffed against reality. Worth enabling for the first live analysis only.
# ETSY_DEBUG_RAW=1

# Request thumbnails via includes=Images. Off by default: it inflates responses
# substantially at limit=100. Turn on once a real shop proves it is safe.
# ETSY_INCLUDE_IMAGES=1
